# Vault passphrase must never be committed (we use --ask-vault-pass anyway).
.vault_pass
vault-password*
*.retry

# Generated by the deploy_target role: prod's pinned host key in known_hosts format.
# Not a secret (host keys are public by design), but machine-generated output —
# its home is the GitHub Actions variable PROD_SSH_KNOWN_HOSTS, not git.
prod_known_hosts
