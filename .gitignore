# ── Gradle ────────────────────────────────────────────────────────────────────
.gradle/
build/
bin/
!gradle/wrapper/gradle-wrapper.jar   # wrapper jar must be committed

# ── Node / pnpm ───────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
# Der Workspace hat genau eine Sperrdatei: pnpm-lock.yaml im Wurzelverzeichnis.
# Ein package-lock.json daneben wird von niemandem gelesen und driftet still ab.
package-lock.json
yarn.lock

# ── Compiled output ───────────────────────────────────────────────────────────
dist/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ── OpenAPI generated sources (re-generated by buildAll / openApiGenerate) ────
openapi-client/src/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Test reports ──────────────────────────────────────────────────────────────
TEST*.xml

# ── Local planning docs (not for version control) ─────────────────────────────
docs/local/

# ── Claude Code ───────────────────────────────────────────────────────────────
# Agenten und Skills sind versioniert — sie tragen Projektwissen.
# Persönliche Berechtigungen sind es nicht.
.claude/settings.local.json

# ── Obsidian-Vault (docs/) ────────────────────────────────────────────────────
# Allowlist statt Denylist: alles ignorieren, die vier Konventionsdateien
# ausnehmen. Obsidian legt laufend neue Dateien hier an; eine Denylist würde
# jede davon durchlassen.
docs/.obsidian/*
!docs/.obsidian/app.json
!docs/.obsidian/core-plugins.json
!docs/.obsidian/templates.json
!docs/.obsidian/types.json
