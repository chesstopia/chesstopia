{
  "name": "@chesstopia/openapi-client",
  "version": "0.0.1",
  "private": true,
  "description": "Generated TypeScript Axios client — do not edit manually, re-run pnpm generate",
  "scripts": {
    "generate": "openapi-generator-cli generate -i ../docs/api/openapi.yaml -g typescript-axios -o src --additional-properties=supportsES6=true,withSeparateModelsAndApi=true,apiPackage=api,modelPackage=model,npmName=@chesstopia/openapi-client"
  },
  "main": "src/index.ts",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3"
  },
  "dependencies": {
    "axios": "^1.7.0"
  }
}
